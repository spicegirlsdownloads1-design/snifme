{
  "manifest_version": 3,
  "name": "Trufflehog Intelligence \u2014 Local Inspector",
  "short_name": "Trufflehog Intel",
  "version": "7.19.0",
  "description": "Generic passive browser sniffer with durable incremental capture journal, security intelligence and global pause.",
  "action": {
    "default_title": "Trufflehog Intelligence",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "downloads",
    "notifications"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "devtools_page": "devtools.html",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
